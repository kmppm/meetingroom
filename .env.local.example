# ============================================
# Upstash Redis (Database)
# Get these from your Upstash Redis dashboard → REST API section
# ============================================
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ============================================
# Session secret
# Any long random string (32+ characters). Used to sign login sessions.
# You can generate one at https://generate-secret.vercel.app/32
# ============================================
SESSION_SECRET=change-this-to-a-long-random-string-min-32-chars

# ============================================
# Admin account (you) — full access to all units
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ============================================
# Unit accounts — one login per division
# Feel free to change the usernames/passwords, just keep the variable names
# ============================================

# Knowledge and Innovation
UNIT_KI_USERNAME=ki
UNIT_KI_PASSWORD=change-this-password

# Strategy and Growth
UNIT_SG_USERNAME=sg
UNIT_SG_PASSWORD=change-this-password

# Risk and Quality
UNIT_RQ_USERNAME=rq
UNIT_RQ_PASSWORD=change-this-password

# Lembaga Sertifikasi Profesi
UNIT_LSP_USERNAME=lsp
UNIT_LSP_PASSWORD=change-this-password
